---
import { site } from '../../data/site';

const actions = [
	{
		kind: 'phone',
		label: 'Звонок',
		accessibleLabel: `Позвонить: ${site.business.phone.display}`,
		href: site.business.phone.href,
		external: false,
	},
	{
		kind: 'vk',
		label: 'VK',
		accessibleLabel: 'Открыть сообщество во ВКонтакте',
		href: site.links.vk,
		external: true,
	},
	{
		kind: 'route',
		label: 'Маршрут',
		accessibleLabel: 'Построить маршрут в Яндекс Картах',
		href: site.links.route,
		external: true,
	},
] as const;
---

<nav aria-label="Быстрые действия" class="mobile-actions">
	<div class="mobile-actions__inner">
		{
			actions.map((action) => (
				<a
					aria-label={action.accessibleLabel}
					class:list={['mobile-actions__link', `mobile-actions__link--${action.kind}`]}
					href={action.href}
					rel={action.external ? 'noreferrer' : undefined}
					target={action.external ? '_blank' : undefined}
				>
					{action.kind === 'phone' && (
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d="M7.3 3.75 9.7 8.2 7.92 9.77a14.7 14.7 0 0 0 6.3 6.3l1.58-1.77 4.45 2.4v2.16a1.7 1.7 0 0 1-1.7 1.7A15.1 15.1 0 0 1 3.44 5.45a1.7 1.7 0 0 1 1.7-1.7H7.3Z" />
						</svg>
					)}
					{action.kind === 'vk' && (
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d="M5.2 7.2c.1 5.7 3 9.2 8.2 9.2h.3v-3.3c1.8.2 3.1 1.5 3.7 3.3h2.8c-.8-2.7-2.9-4.1-4.2-4.6 1.3-.7 3.1-2.3 3.6-4.6h-2.5c-.6 1.8-2 3.4-3.4 3.5V7.2h-2.6v6.2c-1.5-.4-3.4-2.1-3.5-6.2H5.2Z" />
						</svg>
					)}
					{action.kind === 'route' && (
						<svg aria-hidden="true" viewBox="0 0 24 24">
							<path d="M12 21s6-5.4 6-11a6 6 0 1 0-12 0c0 5.6 6 11 6 11Z" />
							<circle cx="12" cy="10" r="2.1" />
						</svg>
					)}
					<span>{action.label}</span>
				</a>
			))
		}
	</div>
</nav>

<style>
	.mobile-actions {
		--actions-paper: var(--color-paper, oklch(0.965 0.012 82));
		--actions-ink: var(--color-ink, oklch(0.36 0.09 242));
		--actions-ink-deep: var(--color-ink-deep, oklch(0.285 0.083 241));
		--actions-coral: var(--color-coral, oklch(0.66 0.145 39));
		--actions-coral-hover: var(--color-coral-hover, oklch(0.6 0.16 36));
		--actions-hairline: var(--color-hairline, oklch(0.84 0.025 235));
		display: none;
	}

	@media (max-width: 59.999rem) {
		.mobile-actions {
			position: fixed;
			z-index: 40;
			inset: auto 0 0;
			display: block;
			padding: 0.45rem 0.65rem max(0.45rem, env(safe-area-inset-bottom));
			color: var(--actions-ink-deep);
			background: var(--actions-paper);
			border-top: 1px solid var(--actions-hairline);
			font-family: var(--font-body, 'Manrope Variable', 'Manrope', sans-serif);
		}

		.mobile-actions__inner {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 0.38rem;
			width: min(100%, 32rem);
			margin-inline: auto;
		}

		.mobile-actions__link {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.38rem;
			min-width: 0;
			min-height: 3.25rem;
			padding: 0.35rem 0.45rem;
			color: var(--actions-ink-deep);
			border-radius: 0.75rem;
			font-size: clamp(0.7rem, 3.4vw, 0.82rem);
			font-weight: 750;
			line-height: 1;
			text-decoration: none;
			transition:
				color 180ms ease,
				background-color 180ms ease,
				transform 180ms ease;
		}

		.mobile-actions__link:hover {
			background: color-mix(in oklch, var(--actions-hairline) 48%, transparent);
		}

		.mobile-actions__link--phone {
			color: var(--actions-paper);
			background: var(--actions-coral);
		}

		.mobile-actions__link--phone:hover {
			background: var(--actions-coral-hover);
		}

		.mobile-actions__link:focus-visible {
			outline: 3px solid var(--actions-coral);
			outline-offset: 2px;
		}

		.mobile-actions__link--phone:focus-visible {
			outline-color: var(--actions-ink-deep);
		}

		.mobile-actions__link:active {
			transform: scale(0.98);
		}

		.mobile-actions__link svg {
			flex: 0 0 auto;
			width: 1.18rem;
			height: 1.18rem;
			fill: none;
			stroke: currentColor;
			stroke-linecap: round;
			stroke-linejoin: round;
			stroke-width: 1.65;
		}

		.mobile-actions__link--vk svg {
			fill: currentColor;
			stroke: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-actions__link {
			transition-duration: 0.01ms;
		}
	}

	@media print {
		.mobile-actions {
			display: none;
		}
	}
</style>
