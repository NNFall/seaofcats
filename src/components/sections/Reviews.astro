---
import { Image } from 'astro:assets';
import teaTable from '../../assets/images/venue/tea-table.webp';
import { site } from '../../data/site';

const reviewThemes = [
  {
    title: 'Спокойная, домашняя атмосфера',
    text: 'Посетители часто описывают зал как светлое и тихое место, где легко замедлиться.',
  },
  {
    title: 'Ухоженные котики и чистый зал',
    text: 'В отзывах отмечают заботу о животных и порядок в пространстве.',
  },
  {
    title: 'Внимательное общение и занятия для отдыха',
    text: 'Гостям запоминаются доброжелательный администратор, книги, настольные игры и чай.',
  },
];
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="reviews__inner">
    <div class="reviews__content" data-reveal>
      <p class="reviews__eyebrow">Впечатления гостей</p>
      <h2 id="reviews-title">Что чаще всего остаётся в памяти</h2>
      <p class="reviews__lead">
        Мы собрали повторяющиеся темы из открытых отзывов, не меняя их общий смысл.
      </p>

      <ol class="reviews__themes">
        {reviewThemes.map((theme) => (
          <li class="reviews__theme">
            <h3>{theme.title}</h3>
            <p>{theme.text}</p>
          </li>
        ))}
      </ol>

      <div class="reviews__source">
        <p>Это краткий пересказ типичных тем, а не дословные цитаты.</p>
        <a href={site.links.maps} target="_blank" rel="noreferrer">
          Читать отзывы на Яндекс Картах
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 5l5 5-5 5" />
          </svg>
        </a>
      </div>
    </div>

    <figure class="reviews__figure" data-reveal>
      <div class="reviews__photo">
        <Image
          src={teaTable}
          alt="Чайник, кружки и сладости на деревянном столе в котокафе"
          loading="lazy"
          decoding="async"
          quality={84}
        />
      </div>
      <figcaption>Чай и сладости в пространстве «Море Котиков»</figcaption>
    </figure>
  </div>
</section>

<style>
  .reviews {
    --reviews-paper: var(--color-paper, var(--paper, oklch(0.965 0.012 82)));
    --reviews-warm: var(--color-paper-warm, var(--paper-warm, oklch(0.93 0.028 73)));
    --reviews-navy: var(--color-ink, var(--color-navy, oklch(0.36 0.09 242)));
    --reviews-deep: var(--color-ink-deep, var(--color-navy-deep, oklch(0.285 0.083 241)));
    --reviews-mist: var(--color-mist, var(--mist, oklch(0.91 0.025 235)));
    --reviews-coral: var(--color-coral, var(--coral, oklch(0.66 0.145 39)));
    --reviews-coral-text: var(--color-coral-on-dark, oklch(0.78 0.11 45));
    color: var(--reviews-paper);
    background: var(--reviews-deep);
    padding: clamp(5.5rem, 10vw, 10rem) var(--page-gutter, clamp(1rem, 5vw, 5.5rem));
    overflow: clip;
  }

  .reviews__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(21rem, 0.68fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: center;
    width: 100%;
    max-width: var(--content-width, 94rem);
    margin-inline: auto;
  }

  .reviews__content {
    min-width: 0;
  }

  .reviews__eyebrow {
    margin: 0 0 1rem;
    color: var(--reviews-coral-text);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .reviews h2 {
    max-width: 10ch;
    margin: 0;
    font-family: var(--font-display, 'Oranienbaum', Georgia, serif);
    font-size: clamp(3rem, 5.25vw, 5.4rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .reviews__lead {
    max-width: 39rem;
    margin: 1.5rem 0 0;
    color: var(--reviews-mist);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: clamp(1rem, 1.2vw, 1.18rem);
    line-height: 1.65;
  }

  .reviews__themes {
    margin: clamp(2.75rem, 5vw, 4.75rem) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: review-theme;
  }

  .reviews__theme {
    counter-increment: review-theme;
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.72fr) minmax(0, 1fr);
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
    border-top: 1px solid color-mix(in oklch, var(--reviews-mist) 32%, transparent);
    padding-block: 1.45rem 1.6rem;
  }

  .reviews__theme:last-child {
    border-bottom: 1px solid color-mix(in oklch, var(--reviews-mist) 32%, transparent);
  }

  .reviews__theme::before {
    content: counter(review-theme, decimal-leading-zero);
    color: var(--reviews-coral-text);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .reviews__theme h3,
  .reviews__theme p {
    margin: 0;
  }

  .reviews__theme h3 {
    color: var(--reviews-paper);
    font-family: var(--font-display, 'Oranienbaum', Georgia, serif);
    font-size: clamp(1.45rem, 1.85vw, 1.95rem);
    font-weight: 400;
    line-height: 1.12;
  }

  .reviews__theme p {
    color: var(--reviews-mist);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.62;
  }

  .reviews__source {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
  }

  .reviews__source p {
    max-width: 28rem;
    margin: 0;
    color: color-mix(in oklch, var(--reviews-mist) 78%, transparent);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .reviews__source a {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid color-mix(in oklch, var(--reviews-mist) 50%, transparent);
    border-radius: 999px;
    padding: 0.85rem 1.35rem;
    color: var(--reviews-paper);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .reviews__source svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .reviews__source a:focus-visible {
    outline: 3px solid var(--reviews-paper);
    outline-offset: 3px;
  }

  .reviews__source a:active {
    transform: translateY(1px);
  }

  .reviews__figure {
    min-width: 0;
    margin: 0;
  }

  .reviews__photo {
    aspect-ratio: 0.72;
    overflow: hidden;
    border-radius: 15rem 15rem 1.5rem 1.5rem;
    background: var(--reviews-navy);
  }

  .reviews__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% center;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reviews__figure figcaption {
    margin-top: 0.8rem;
    color: color-mix(in oklch, var(--reviews-mist) 72%, transparent);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  @media (hover: hover) {
    .reviews__source a:hover {
      border-color: var(--reviews-paper);
      color: var(--reviews-deep);
      background: var(--reviews-paper);
    }

    .reviews__figure:hover .reviews__photo :global(img) {
      transform: scale(1.025);
    }
  }

  @media (max-width: 61.25rem) {
    .reviews__inner {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.6fr);
      gap: clamp(2.5rem, 5vw, 4rem);
    }

    .reviews__theme {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }

    .reviews__theme p {
      grid-column: 2;
    }
  }

  @media (max-width: 48rem) {
    .reviews {
      padding-block: clamp(4.5rem, 18vw, 7rem);
      padding-inline: 1rem;
    }

    .reviews__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    .reviews h2 {
      font-size: clamp(2.5rem, 12vw, 3rem);
    }

    .reviews__figure {
      display: grid;
      grid-template-columns: minmax(0, 0.88fr) minmax(2.5rem, 0.12fr);
      order: -1;
    }

    .reviews__photo {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3;
      border-radius: 7rem 7rem 1.25rem 1.25rem;
    }

    .reviews__photo :global(img) {
      object-position: center 48%;
    }

    .reviews__figure figcaption {
      grid-column: 1;
    }

    .reviews__themes {
      margin-top: 2.75rem;
    }

    .reviews__source {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 28rem) {
    .reviews__theme {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }

    .reviews__theme p {
      grid-column: 1;
    }

    .reviews__source a {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews__photo :global(img),
    .reviews__source a {
      transition-duration: 0.001ms;
    }

    .reviews__figure:hover .reviews__photo :global(img),
    .reviews__source a:active {
      transform: none;
    }
  }
</style>
