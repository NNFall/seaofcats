---
import { Image } from 'astro:assets';
import heroCat from '../../assets/images/venue/hero-cat.webp';
import { links } from '../../data/site';
---

<section class="hero section reveal" aria-labelledby="hero-title">
	<svg class="hero__birds" viewBox="0 0 112 54" aria-hidden="true">
		<path d="M2 17c10-8 19-7 28 2 9-9 18-10 29-2" />
		<path d="M58 40c7-6 14-5 21 2 7-7 14-8 22-2" />
	</svg>

	<svg class="hero__waves" viewBox="0 0 180 120" aria-hidden="true">
		<path d="M4 21c28-27 55 27 83 0s55 27 84 0" />
		<path d="M4 52c28-27 55 27 83 0s55 27 84 0" />
		<path d="M4 83c28-27 55 27 83 0s55 27 84 0" />
	</svg>

	<svg class="hero__coral" viewBox="0 0 104 172" aria-hidden="true">
		<path d="M53 170c1-43-3-88 1-141M53 83 25 50M51 110 79 74M52 58 73 35M43 72 36 35M25 50 16 24M79 74 92 48M73 35 78 13M36 35 30 13" />
		<circle cx="16" cy="22" r="3" /><circle cx="30" cy="11" r="3" />
		<circle cx="78" cy="11" r="3" /><circle cx="93" cy="46" r="3" />
		<circle cx="24" cy="48" r="3" /><circle cx="80" cy="72" r="3" />
	</svg>

	<div class="hero__inner">
		<header class="hero__copy">
			<p class="hero__eyebrow">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 20.4S4.2 16 4.2 9.7A4.1 4.1 0 0 1 12 7.8a4.1 4.1 0 0 1 7.8 1.9C19.8 16 12 20.4 12 20.4Z" />
				</svg>
				Твоё место для тихого отдыха
			</p>

			<h1 id="hero-title">
				<span class="sr-only">Котокафе «Море Котиков»: </span>
				Тепло, мурчание <br />и спокойствие
			</h1>

			<p class="hero__lead">
				Котокафе-антикафе в Самаре, где можно провести время рядом с котиками
				и отдохнуть от городского ритма.
			</p>
		</header>

		<nav class="hero__actions" aria-label="Как связаться с котокафе">
			<a class="hero__action hero__action--primary" href="#contact">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 3v14M8.5 7h7M5 13c0 4.4 3.1 7 7 7s7-2.6 7-7M5 13H2.8M19 13h2.2" />
				</svg>
				Уточнить визит
			</a>
			<a class="hero__action hero__action--secondary" href={links.vk} target="_blank" rel="noreferrer">
				Написать в VK
			</a>
			<a class="hero__route" href={links.route} target="_blank" rel="noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 21s6-6.4 6-12A6 6 0 1 0 6 9c0 5.6 6 12 6 12Z" />
					<circle cx="12" cy="9" r="2" />
				</svg>
				Построить маршрут
			</a>
		</nav>

		<figure class="hero__media">
			<div class="hero__arch">
				<Image
					src={heroCat}
					alt="Полосатый кот смотрит в объектив с деревянной площадки котокафе"
					widths={[480, 720, 960, 1200]}
					sizes="(max-width: 959px) 88vw, (max-width: 1400px) 48vw, 640px"
					loading="eager"
					fetchpriority="high"
					quality={88}
				/>
			</div>
			<figcaption>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 20.4S4.2 16 4.2 9.7A4.1 4.1 0 0 1 12 7.8a4.1 4.1 0 0 1 7.8 1.9C19.8 16 12 20.4 12 20.4Z" />
				</svg>
				<span>Настоящий житель «Моря Котиков» смотрит прямо в объектив</span>
			</figcaption>
		</figure>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: calc(100dvh - 6.5rem);
		padding-block: clamp(2.75rem, 5.2vw, 5.5rem) clamp(5rem, 8vw, 8.5rem);
		color: var(--color-ink, oklch(0.36 0.09 242));
		overflow: clip;
		isolation: isolate;
	}

	.hero::before {
		position: absolute;
		inset: auto -12% -19rem 38%;
		z-index: -1;
		height: 34rem;
		content: '';
		background: radial-gradient(ellipse at center, color-mix(in oklch, var(--color-mist, oklch(0.91 0.025 235)) 72%, transparent), transparent 68%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(30rem, 0.92fr);
		grid-template-areas:
			'copy media'
			'actions media';
		column-gap: clamp(3rem, 5.6vw, 6.25rem);
		row-gap: clamp(2rem, 3.4vw, 3.25rem);
		width: min(
			var(--container-max, 94rem),
			calc(
				100% - var(--page-gutter, clamp(1rem, 5vw, 5.5rem)) - var(--page-gutter, clamp(1rem, 5vw, 5.5rem))
			)
		);
		margin-inline: auto;
	}

	.hero__copy {
		grid-area: copy;
		align-self: end;
		max-width: 44rem;
		padding-top: clamp(1rem, 7vh, 4.75rem);
	}

	.hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 2.8rem;
		margin: 0 0 clamp(1.8rem, 3vw, 3.2rem);
		padding: 0.55rem 1rem;
		border: 1px solid var(--color-hairline, oklch(0.84 0.025 235));
		border-radius: 999px;
		color: var(--color-ink-muted, oklch(0.55 0.045 238));
		font: 500 clamp(0.9rem, 1.15vw, 1.08rem) / 1.3 var(--font-body, sans-serif);
	}

	.hero__eyebrow svg,
	.hero__media figcaption svg,
	.hero__action svg,
	.hero__route svg {
		width: 1.35rem;
		height: 1.35rem;
		flex: 0 0 auto;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	h1 {
		max-width: 16ch;
		margin: 0;
		color: var(--color-ink-deep, oklch(0.285 0.083 241));
		font-family: var(--font-display, serif);
		font-size: clamp(3.25rem, 5.05vw, 5.25rem);
		font-weight: 400;
		line-height: 0.94;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.hero__lead {
		max-width: 39rem;
		margin: clamp(1.55rem, 2.5vw, 2.25rem) 0 0;
		color: var(--color-ink-muted, oklch(0.55 0.045 238));
		font: 400 clamp(1rem, 1.22vw, 1.25rem) / 1.58 var(--font-body, sans-serif);
	}

	.hero__actions {
		grid-area: actions;
		display: grid;
		grid-template-columns: max-content max-content;
		align-items: center;
		justify-content: start;
		gap: 0.85rem 1rem;
	}

	.hero__action,
	.hero__route {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3.5rem;
		border-radius: 999px;
		font: 650 0.98rem / 1 var(--font-body, sans-serif);
		text-decoration: none;
		transition:
			background-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
			border-color 280ms cubic-bezier(0.16, 1, 0.3, 1),
			color 280ms cubic-bezier(0.16, 1, 0.3, 1),
			transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero__action:active,
	.hero__route:active {
		transform: translateY(1px) scale(0.985);
	}

	.hero__action--primary {
		gap: 0.7rem;
		padding-inline: 1.65rem;
		background: var(--color-coral, oklch(0.66 0.145 39));
		color: var(--color-paper, oklch(0.965 0.012 82));
	}

	.hero__action--primary:hover {
		background: var(--color-coral-hover, oklch(0.6 0.16 36));
	}

	.hero__action--secondary {
		padding-inline: 1.55rem;
		border: 1px solid var(--color-hairline, oklch(0.84 0.025 235));
		color: var(--color-ink, oklch(0.36 0.09 242));
	}

	.hero__action--secondary:hover {
		border-color: var(--color-ink-muted, oklch(0.55 0.045 238));
		background: color-mix(in oklch, var(--color-mist, oklch(0.91 0.025 235)) 42%, transparent);
	}

	.hero__route {
		grid-column: 1 / -1;
		justify-self: start;
		gap: 0.55rem;
		min-height: 2.75rem;
		padding-inline: 0.3rem;
		border-radius: 0;
		color: var(--color-ink, oklch(0.36 0.09 242));
		text-decoration: underline;
		text-decoration-color: var(--color-hairline, oklch(0.84 0.025 235));
		text-decoration-thickness: 1px;
		text-underline-offset: 0.35rem;
	}

	.hero__route:hover {
		text-decoration-color: var(--color-coral, oklch(0.66 0.145 39));
	}

	.hero__action:focus-visible,
	.hero__route:focus-visible {
		outline: 3px solid var(--color-coral, oklch(0.66 0.145 39));
		outline-offset: 4px;
	}

	.hero__media {
		position: relative;
		grid-area: media;
		align-self: start;
		min-width: 0;
		margin: 0;
		padding-bottom: 2.9rem;
	}

	.hero__arch {
		aspect-ratio: 637 / 750;
		overflow: hidden;
		border-radius: 50% 50% 0 0 / 42.5% 42.5% 0 0;
		background: var(--color-mist, oklch(0.91 0.025 235));
	}

	.hero__arch :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 48%;
		transition: transform 760ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.hero__media:hover .hero__arch :global(img) {
		transform: scale(1.018);
	}

	.hero__media figcaption {
		position: absolute;
		right: 4%;
		bottom: 0;
		left: 13%;
		display: flex;
		align-items: center;
		gap: 0.85rem;
		min-height: 4.5rem;
		margin: 0;
		padding: 1rem 1.5rem;
		border: 1px solid color-mix(in oklch, var(--color-paper, oklch(0.965 0.012 82)) 55%, transparent);
		border-radius: 999px;
		background: color-mix(in oklch, var(--color-mist, oklch(0.91 0.025 235)) 88%, var(--color-paper, oklch(0.965 0.012 82)));
		color: var(--color-ink, oklch(0.36 0.09 242));
		font: 500 clamp(0.88rem, 1.1vw, 1.06rem) / 1.35 var(--font-body, sans-serif);
	}

	.hero__birds,
	.hero__waves,
	.hero__coral {
		position: absolute;
		z-index: 0;
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		pointer-events: none;
	}

	.hero__birds {
		top: 15%;
		left: 43.5%;
		width: clamp(5rem, 7vw, 7rem);
		stroke: var(--color-ink, oklch(0.36 0.09 242));
		stroke-width: 2.3;
	}

	.hero__waves {
		top: 18%;
		right: -2.5rem;
		width: clamp(8rem, 12vw, 12rem);
		stroke: var(--color-hairline, oklch(0.84 0.025 235));
		stroke-width: 1.45;
	}

	.hero__coral {
		top: 40%;
		left: 45.5%;
		width: clamp(4.5rem, 6vw, 6.4rem);
		stroke: var(--color-coral, oklch(0.66 0.145 39));
		stroke-width: 1.55;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 60rem) {
		.hero {
			margin-top: -2rem;
			padding-top: 0;
			padding-bottom: clamp(3.25rem, 4vw, 4.5rem);
		}

		.hero__inner {
			grid-template-columns: minmax(0, 1.02fr) minmax(29rem, 0.88fr);
		}

		.hero__copy {
			align-self: start;
			padding-top: clamp(5rem, 7.2vw, 7.5rem);
		}

		.hero__eyebrow {
			margin-bottom: 2rem;
		}

		.hero__actions {
			transform: translateY(-6.8rem);
		}
	}

	@media (max-width: 959px) {
		.hero {
			min-height: auto;
			padding-block: clamp(2rem, 7vw, 3.5rem) clamp(5.5rem, 13vw, 7rem);
		}

		.hero__inner {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas:
				'copy'
				'media'
				'actions';
			gap: 2rem;
		}

		.hero__copy {
			max-width: 42rem;
			padding-top: 0;
		}

		.hero__media {
			width: min(100%, 34rem);
			justify-self: center;
			margin-top: 0.5rem;
		}

		.hero__actions {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			width: min(100%, 34rem);
			justify-self: center;
		}

		.hero__action--primary {
			grid-column: 1 / -1;
		}

		.hero__route {
			grid-column: auto;
			justify-self: stretch;
		}

		.hero__birds {
			top: 31%;
			left: auto;
			right: 8%;
		}

		.hero__coral {
			top: 35%;
			left: 5%;
		}
	}

	@media (max-width: 640px) {
		.hero__eyebrow {
			min-height: 2.55rem;
			margin-bottom: 1.55rem;
			font-size: 0.82rem;
		}

		h1 {
			max-width: 13ch;
			font-size: clamp(2.4rem, 12vw, 3.05rem);
			line-height: 0.93;
		}

		.hero__lead {
			margin-top: 1.35rem;
			font-size: 1rem;
			line-height: 1.55;
		}

		.hero__media {
			width: min(100%, 29rem);
			padding-bottom: 2.15rem;
		}

		.hero__media figcaption {
			right: 0;
			left: 7%;
			min-height: 3.9rem;
			padding: 0.85rem 1rem;
			font-size: 0.82rem;
		}

		.hero__actions {
			width: 100%;
			gap: 0.75rem;
		}

		.hero__action,
		.hero__route {
			min-height: 3.25rem;
			font-size: 0.9rem;
		}

		.hero__action--secondary {
			padding-inline: 1rem;
		}

		.hero__birds {
			display: none;
		}

		.hero__coral {
			top: 34%;
			left: 1%;
			width: 3.75rem;
		}

		.hero__waves {
			top: 44%;
			right: -3rem;
		}
	}

	@media (max-width: 379px) {
		.hero__actions {
			grid-template-columns: 1fr;
		}

		.hero__action--primary,
		.hero__route {
			grid-column: auto;
		}

		.hero__route {
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__arch :global(img),
		.hero__action,
		.hero__route {
			transition: none;
		}

		.hero__media:hover .hero__arch :global(img) {
			transform: none;
		}
	}
</style>
