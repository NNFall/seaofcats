---
import { Image } from 'astro:assets';
import facade from '../../assets/images/venue/facade.webp';
import { site } from '../../data/site';

const mondaySchedule = site.hours.schedule[0];
const regularSchedule = site.hours.schedule[1];
const closedHours = mondaySchedule.closed ? 'Пн закрыто' : 'Пн: уточните график';
const regularHours = `Вт-Вс ${regularSchedule.opens}-${regularSchedule.closes}`;
const checkedAt = site.hours.sourceCheckedAt.split('-').reverse().join('.');
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__inner">
    <header class="contact__header" data-reveal>
      <p class="contact__eyebrow">Как нас найти</p>
      <h2 id="contact-title">Встретимся на Дыбенко</h2>
      <p>
        Красное здание с вывеской «Море Котиков» находится рядом с «Космопортом».
        Выберите удобный способ связи или сразу постройте маршрут.
      </p>
    </header>

    <div class="contact__scene" data-reveal>
      <figure class="contact__figure">
        <div class="contact__photo">
          <Image
            src={facade}
            alt="Красный фасад котокафе «Море Котиков» на улице Дыбенко"
            loading="lazy"
            decoding="async"
            quality={86}
          />
        </div>
        <figcaption>Вход в котокафе со стороны улицы Дыбенко</figcaption>
      </figure>

      <div class="contact__panel">
        <dl class="contact__facts">
          <div class="contact__fact">
            <dt>Адрес</dt>
            <dd>
              <a href={site.links.route} target="_blank" rel="noreferrer">
                {site.business.address.display}
              </a>
            </dd>
          </div>
          <div class="contact__fact">
            <dt>Телефон</dt>
            <dd>
              <a href={site.business.phone.href}>{site.business.phone.display}</a>
            </dd>
          </div>
          <div class="contact__fact">
            <dt>Часы работы</dt>
            <dd>
              <span>{closedHours}</span>
              <span>{regularHours}</span>
            </dd>
          </div>
        </dl>

        <p class="contact__check">
          Проверено {checkedAt} по открытой карточке
          <a href={site.links.maps} target="_blank" rel="noreferrer">Яндекс Карт</a>.
          Перед поездкой проверьте обновления.
        </p>

        <div class="contact__actions" aria-label="Способы связи и маршрут">
          <a
            class="contact__button contact__button--primary"
            href={site.links.route}
            target="_blank"
            rel="noreferrer"
          >
            Построить маршрут
          </a>
          <a
            class="contact__button contact__button--secondary"
            href={site.links.vk}
            target="_blank"
            rel="noreferrer"
          >
            Написать в VK
          </a>
          <a class="contact__button contact__button--secondary" href={site.business.phone.href}>
            Позвонить
          </a>
          <a
            class="contact__button contact__button--secondary"
            href={site.links.max}
            target="_blank"
            rel="noreferrer"
          >
            Открыть MAX
          </a>
          <a
            class="contact__button contact__button--secondary"
            href={site.links.maps}
            target="_blank"
            rel="noreferrer"
          >
            Яндекс Карты
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    --contact-paper: var(--color-paper, var(--paper, oklch(0.965 0.012 82)));
    --contact-warm: var(--color-paper-warm, var(--paper-warm, oklch(0.93 0.028 73)));
    --contact-mist: var(--color-mist, var(--mist, oklch(0.91 0.025 235)));
    --contact-navy: var(--color-ink, var(--color-navy, oklch(0.36 0.09 242)));
    --contact-deep: var(--color-ink-deep, var(--color-navy-deep, oklch(0.285 0.083 241)));
    --contact-muted: var(--color-ink-readable, oklch(0.47 0.045 238));
    --contact-coral: var(--color-coral, var(--coral, oklch(0.66 0.145 39)));
    --contact-coral-text: var(--color-coral-text, oklch(0.5 0.145 36));
    --contact-coral-action: var(--color-coral-action, oklch(0.48 0.145 36));
    --contact-coral-action-hover: var(--color-coral-action-hover, oklch(0.43 0.145 36));
    --contact-line: var(--color-hairline, var(--hairline, oklch(0.84 0.025 235)));
    color: var(--contact-navy);
    background: var(--contact-warm);
    padding: clamp(5.5rem, 10vw, 10rem) var(--page-gutter, clamp(1rem, 5vw, 5.5rem));
    overflow: clip;
  }

  .contact__inner {
    width: 100%;
    max-width: var(--content-width, 94rem);
    margin-inline: auto;
  }

  .contact__header {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(18rem, 0.55fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: end;
    max-width: 68rem;
  }

  .contact__eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 -1rem;
    color: var(--contact-coral-text);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact h2 {
    margin: 0;
    font-family: var(--font-display, 'Oranienbaum', Georgia, serif);
    font-size: clamp(3.2rem, 5.8vw, 5.8rem);
    font-weight: 400;
    line-height: 0.93;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .contact__header > p:last-child {
    max-width: 33rem;
    margin: 0;
    color: var(--contact-muted);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: clamp(1rem, 1.15vw, 1.16rem);
    line-height: 1.65;
  }

  .contact__scene {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    margin-top: clamp(2rem, 3vw, 3rem);
  }

  .contact__figure {
    grid-column: 4 / 13;
    grid-row: 1;
    min-width: 0;
    margin: 0;
  }

  .contact__photo {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1.25rem 9rem 1.25rem 1.25rem;
    background: var(--contact-mist);
  }

  .contact__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact__figure figcaption {
    margin-top: 0.75rem;
    color: var(--contact-muted);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.78rem;
    line-height: 1.5;
    text-align: right;
  }

  .contact__panel {
    grid-column: 1 / 7;
    grid-row: 1;
    z-index: 1;
    align-self: start;
    margin-top: -1.5rem;
    border: 1px solid var(--contact-line);
    padding: clamp(1.6rem, 2.6vw, 2.75rem);
    color: var(--contact-navy);
    background: var(--contact-paper);
    box-shadow: 0 2rem 4.5rem -3rem color-mix(in oklch, var(--contact-deep) 38%, transparent);
  }

  .contact__facts {
    margin: 0;
  }

  .contact__fact {
    display: grid;
    grid-template-columns: minmax(6.5rem, 0.55fr) minmax(0, 1.45fr);
    gap: 1.25rem;
    border-top: 1px solid var(--contact-line);
    padding-block: 0.85rem;
  }

  .contact__fact:last-child {
    border-bottom: 1px solid var(--contact-line);
  }

  .contact__fact dt {
    color: var(--contact-muted);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact__fact dd {
    margin: 0;
    color: var(--contact-deep);
    font-family: var(--font-display, 'Oranienbaum', Georgia, serif);
    font-size: clamp(1.35rem, 1.75vw, 1.75rem);
    line-height: 1.16;
  }

  .contact__fact dd span {
    display: block;
  }

  .contact__fact dd span + span {
    margin-top: 0.3rem;
  }

  .contact__fact a,
  .contact__check a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    max-width: 100%;
    align-items: center;
    color: inherit;
    text-decoration-color: var(--contact-coral-text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .contact__check {
    margin: 0.8rem 0 0;
    color: var(--contact-muted);
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .contact__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  .contact__button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--contact-navy);
    border-radius: 999px;
    padding: 0.85rem 1.3rem;
    font-family: var(--font-body, 'Manrope', sans-serif);
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  .contact__button--primary {
    border-color: var(--contact-coral-action);
    color: var(--contact-paper);
    background: var(--contact-coral-action);
  }

  .contact__button--secondary {
    color: var(--contact-navy);
    background: transparent;
  }

  .contact__button:focus-visible,
  .contact__fact a:focus-visible,
  .contact__check a:focus-visible {
    outline: 3px solid var(--contact-deep);
    outline-offset: 3px;
  }

  .contact__button:active {
    transform: translateY(1px);
  }

  @media (hover: hover) {
    .contact__button--primary:hover {
      border-color: var(--contact-coral-action-hover);
      background: var(--contact-coral-action-hover);
    }

    .contact__button--secondary:hover {
      color: var(--contact-paper);
      background: var(--contact-navy);
    }

    .contact__fact a:hover,
    .contact__check a:hover {
      color: var(--contact-coral-action-hover);
    }

    .contact__figure:hover .contact__photo :global(img) {
      transform: scale(1.025);
    }
  }

  @media (max-width: 61.25rem) {
    .contact__header {
      grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
    }

    .contact__figure {
      grid-column: 3 / 13;
    }

    .contact__panel {
      grid-column: 1 / 8;
    }

    .contact__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact__button--primary {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 48rem) {
    .contact {
      padding-block: clamp(4.5rem, 18vw, 7rem);
      padding-inline: 1rem;
    }

    .contact__header {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .contact__eyebrow {
      margin-bottom: 0;
    }

    .contact h2 {
      font-size: clamp(2.5rem, 12vw, 3rem);
    }

    .contact__scene {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 2.75rem;
    }

    .contact__figure,
    .contact__panel {
      grid-column: 1;
    }

    .contact__figure {
      grid-row: 1;
    }

    .contact__photo {
      aspect-ratio: 4 / 3;
      border-radius: 1rem 6rem 1rem 1rem;
    }

    .contact__figure figcaption {
      display: none;
    }

    .contact__panel {
      grid-row: 2;
      z-index: 1;
      width: calc(100% - 1.25rem);
      margin: -2.25rem 0 0 1.25rem;
      padding: 1.5rem;
    }

    .contact__fact {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.55rem;
    }
  }

  @media (max-width: 28rem) {
    .contact__panel {
      width: calc(100% - 0.75rem);
      margin-left: 0.75rem;
      padding: 1.25rem;
    }

    .contact__actions {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__button--primary {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__photo :global(img),
    .contact__button {
      transition-duration: 0.001ms;
    }

    .contact__figure:hover .contact__photo :global(img),
    .contact__button:active {
      transform: none;
    }
  }
</style>
