---
import type { ImageMetadata } from 'astro';

import heroCat from '../assets/images/venue/hero-cat.webp';
import { business, hours, links, seo } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	canonical?: string | URL;
	ogImage?: string | URL | ImageMetadata;
	ogImageAlt?: string;
	noindex?: boolean;
}

const {
	title = seo.title,
	description = seo.description,
	canonical,
	ogImage = heroCat,
	ogImageAlt = 'Полосатый кот в котокафе «Море Котиков»',
	noindex = false,
} = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const withBase = (pathname: string) => {
	const normalizedPath = pathname.replace(/^\/+/, '');

	if (basePath === '/' || pathname.startsWith(basePath)) {
		return pathname.startsWith('/') ? pathname : `/${pathname}`;
	}

	return `${basePath}${normalizedPath}`;
};

const documentBase = Astro.site ?? Astro.url;
const canonicalSource = canonical?.toString();
const canonicalUrl = canonicalSource?.startsWith('http://') || canonicalSource?.startsWith('https://')
	? new URL(canonicalSource)
	: new URL(withBase(canonicalSource ?? Astro.url.pathname), documentBase);

const imageSource =
	typeof ogImage === 'string' || ogImage instanceof URL ? ogImage.toString() : ogImage.src;
const ogImageUrl = new URL(
	imageSource.startsWith('http://') || imageSource.startsWith('https://')
		? imageSource
		: withBase(imageSource),
	documentBase,
);

const openingHoursSpecification = hours.schedule
	.filter((entry) => !entry.closed)
	.map((entry) => ({
		'@type': 'OpeningHoursSpecification',
		dayOfWeek: entry.days,
		opens: 'opens' in entry ? entry.opens : undefined,
		closes: 'closes' in entry ? entry.closes : undefined,
	}));

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CafeOrCoffeeShop',
	name: business.name,
	description: business.description,
	url: canonicalUrl.toString(),
	image: ogImageUrl.toString(),
	telephone: business.phone.href.replace('tel:', ''),
	address: {
		'@type': 'PostalAddress',
		streetAddress: business.address.streetAddress,
		addressLocality: business.address.addressLocality,
		addressCountry: business.address.addressCountry,
	},
	hasMap: links.maps,
	sameAs: [links.vk, links.max, links.maps],
	openingHoursSpecification,
};

const jsonLd = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="manifest" href={withBase('/site.webmanifest')} />

		<meta property="og:locale" content="ru_RU" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={business.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={ogImageAlt} />
		{typeof ogImage !== 'string' && !(ogImage instanceof URL) && (
			<>
				<meta property="og:image:width" content={String(ogImage.width)} />
				<meta property="og:image:height" content={String(ogImage.height)} />
			</>
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<title>{title}</title>
		<script type="application/ld+json" set:html={jsonLd} is:inline></script>
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Перейти к основному содержанию</a>
		<slot name="header" />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		<slot name="footer" />
	</body>
</html>
